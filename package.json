{
  "name": "anime-player",
  "productName": "Anime Player",
  "version": "0.4.2",
  "description": "Libreria di anime a link, riprodotti con mpv e Anime4K",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node test/run.js",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.adriano.animeplayer",
    "productName": "Anime Player",
    "files": ["main.js", "preload.js", "src/**/*", "renderer/**/*", "package.json"],
    "extraResources": [{ "from": "shaders", "to": "shaders" }],
    "win": { "target": ["portable", "nsis"] },
    "portable": { "artifactName": "AnimePlayer-portable.exe" },
    "nsis": {
      "artifactName": "AnimePlayer-Setup-${version}.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Anime Player",
      "deleteAppDataOnUninstall": false
    }
  }
}
