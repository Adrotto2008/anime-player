{
  "name": "anime-player",
  "productName": "Anime Player",
  "version": "0.5.56",
  "description": "Libreria di anime a link, riprodotti con mpv e Anime4K",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "prestart": "node scripts/ensure-electron.js",
    "test": "node test/run.js",
    "dist": "node scripts/build.js",
    "predist": "node scripts/ensure-electron.js",
    "check": "node scripts/check.js"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.adriano.animeplayer",
    "productName": "Anime Player",
    "protocols": [
      {
        "name": "Anime Player password recovery",
        "schemes": [
          "animeplayer"
        ]
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "shaders",
        "to": "shaders"
      },
      {
        "from": ".build-resources/supabase-config.json",
        "to": "supabase-config.json"
      }
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "maintainer": "Arklight <adrianopalmeri02@gmail.com>",
      "artifactName": "AnimePlayer-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.entertainment",
      "artifactName": "AnimePlayer-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "AnimePlayer-portable.exe"
    },
    "nsis": {
      "artifactName": "AnimePlayer-Setup-${version}.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Anime Player",
      "deleteAppDataOnUninstall": false
    },
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Adrotto2008",
        "repo": "anime-player",
        "releaseType": "release"
      }
    ],
    "electronUpdaterCompatibility": ">=2.16"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.109.0",
    "acorn": "8.19.0",
    "cheerio": "1.1.2",
    "electron-updater": "6.8.10",
    "js-yaml": "4.3.2",
    "semver": "7.7.3",
    "tough-cookie": "6.0.2",
    "ws": "8.22.0"
  },
  "overrides": {
    "global-agent": "4.1.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
